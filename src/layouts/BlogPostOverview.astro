---
import type { CollectionEntry } from "astro:content";
import BaseHead from "@/components/BaseHead.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import PostList from "@/components/PostList.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "@/consts";

type Props = {
  posts: CollectionEntry<"blog">[];
  title?: string;
  layout?: "grid" | "index" | "feature-index" | "archive";
  thumbnails?: boolean;
};
const { posts, title, layout = "grid", thumbnails = false } = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <Main>
      {
        title && (
          <header class="mb-12">
            <p class="eyebrow mb-2">Writing</p>
            <h1 class="h1 capitalize">{title}</h1>
          </header>
        )
      }

      <slot name="before-posts" />

      <PostList posts={posts} variant={layout} thumbnails={thumbnails}>
        <slot name="pinned" slot="pinned" />
      </PostList>

      <slot name="after-posts" />
    </Main>
    <Footer />
  </body>
</html>
