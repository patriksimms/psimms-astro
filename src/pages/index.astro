---
import BaseHead from "../components/BaseHead.astro";
import Main from "../components/Main.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <Main>
      <section class="py-8 sm:py-14">
        <p class="eyebrow mb-4">Product Engineer · Hamburg</p>
        <h1 class="h1 mb-6">
          Hey, I'm <a
            class="decoration-timberwolf-700 hover:decoration-primary underline decoration-2 underline-offset-[6px] transition-colors"
            href="https://www.linkedin.com/in/patrik-simms/"
            target="_blank"
            rel="noopener">Patrik</a
          >.
        </h1>
        <p class="text-secondary max-w-2xl text-xl leading-relaxed sm:text-2xl">
          I like product management, web development and video games.
        </p>
      </section>

      <article class="my-prose">
        <p>
          This website is where I keep my articles, thoughts and other random
          stuff.
        </p>
        <p>
          Currently I am working as a Product Engineer at <a
            class="a"
            href="https://esome.com"
            target="_blank"
            rel="noopener">esome advertising technologies GmbH</a
          >, bridging gaps between adtech and advertisers.
        </p>
      </article>

      <nav class="mt-12 flex flex-wrap gap-3">
        <a
          href="/posts/engineering"
          class="bg-primary text-primary-foreground inline-flex items-center rounded-full px-5 py-2 text-sm font-medium transition-opacity hover:opacity-90"
          >Engineering blog →</a
        >
        <a
          href="/posts/other"
          class="border-border bg-card hover:bg-accent text-card-foreground inline-flex items-center rounded-full border px-5 py-2 text-sm font-medium transition-colors"
          >Read the writing →</a
        >
      </nav>
    </Main>
    <Footer />
  </body>
</html>
