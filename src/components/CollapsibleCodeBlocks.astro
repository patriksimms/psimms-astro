<script>
  const MIN_COLLAPSIBLE_LINES = 18;
  const COPY_CONFIRMATION_DURATION = 2000;

  async function copyText(text: string) {
    await navigator.clipboard.writeText(text);
  }

  function enhanceCodeBlocks() {
    const codeBlocks = document.querySelectorAll<HTMLElement>(
      ".my-prose pre:not([data-code-enhanced])",
    );

    codeBlocks.forEach((codeBlock, index) => {
      const code = codeBlock.querySelector("code");
      const source = code?.textContent?.replace(/\n$/, "") ?? "";
      const lineCount = source.split("\n").length;

      const wrapper = document.createElement("div");
      wrapper.className = "code-block";

      const copyButton = document.createElement("button");
      copyButton.className = "code-block__copy";
      copyButton.type = "button";
      copyButton.setAttribute("aria-label", "Copy code");
      copyButton.setAttribute("aria-live", "polite");
      copyButton.title = "Copy code";
      copyButton.innerHTML = `
        <svg class="code-block__copy-icon" aria-hidden="true" viewBox="0 0 20 20" width="15" height="15">
          <rect x="6.5" y="6.5" width="9" height="9" rx="1.5" />
          <path d="M13.5 6.5V5A1.5 1.5 0 0 0 12 3.5H5A1.5 1.5 0 0 0 3.5 5v7A1.5 1.5 0 0 0 5 13.5h1.5" />
        </svg>
        <svg class="code-block__check-icon" aria-hidden="true" viewBox="0 0 20 20" width="15" height="15">
          <path d="m4.5 10 3.5 3.5 7.5-8" />
        </svg>
        <span>Copy</span>
      `;

      codeBlock.dataset.codeEnhanced = "true";
      codeBlock.before(wrapper);
      wrapper.append(codeBlock, copyButton);

      let resetCopyState: number | undefined;
      copyButton.addEventListener("click", async () => {
        window.clearTimeout(resetCopyState);

        try {
          await copyText(source);
          copyButton.dataset.copied = "true";
          copyButton.setAttribute("aria-label", "Code copied");
          copyButton.title = "Code copied";
          copyButton.querySelector("span")!.textContent = "Copied";
        } catch {
          copyButton.dataset.copied = "false";
          copyButton.setAttribute("aria-label", "Copy failed");
          copyButton.title = "Copy failed";
          copyButton.querySelector("span")!.textContent = "Copy failed";
        }

        resetCopyState = window.setTimeout(() => {
          delete copyButton.dataset.copied;
          copyButton.setAttribute("aria-label", "Copy code");
          copyButton.title = "Copy code";
          copyButton.querySelector("span")!.textContent = "Copy";
        }, COPY_CONFIRMATION_DURATION);
      });

      if (lineCount < MIN_COLLAPSIBLE_LINES) return;

      codeBlock.id ||= `code-block-${index + 1}`;
      wrapper.classList.add("code-fold");
      wrapper.dataset.expanded = "false";

      const controls = document.createElement("div");
      controls.className = "code-fold__controls";

      const toggle = document.createElement("button");
      toggle.className = "code-fold__toggle";
      toggle.type = "button";
      toggle.setAttribute("aria-controls", codeBlock.id);
      toggle.setAttribute("aria-expanded", "false");
      toggle.innerHTML = `
        <span>Show all ${lineCount} lines</span>
        <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16">
          <path d="m5 7.5 5 5 5-5" />
        </svg>
      `;

      wrapper.append(controls);
      controls.append(toggle);

      toggle.addEventListener("click", () => {
        const expanded = wrapper.dataset.expanded === "true";
        const nextExpanded = !expanded;

        wrapper.dataset.expanded = String(nextExpanded);
        toggle.setAttribute("aria-expanded", String(nextExpanded));
        toggle.querySelector("span")!.textContent = nextExpanded
          ? "Show less"
          : `Show all ${lineCount} lines`;

        if (!nextExpanded) {
          wrapper.scrollIntoView({ block: "nearest" });
        }
      });
    });
  }

  enhanceCodeBlocks();
  document.addEventListener("astro:page-load", enhanceCodeBlocks);
</script>

<style is:global>
  .my-prose .code-block {
    --code-surface: #282c34;
