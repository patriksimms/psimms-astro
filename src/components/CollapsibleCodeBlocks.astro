    border-radius: var(--radius);
    background: var(--code-surface);
  }

  .my-prose .code-block pre {
    margin-block: 0;
    border-radius: inherit;
  }

  .my-prose .code-fold[data-expanded="false"] pre {
    max-height: 22rem;
    overflow: hidden;
  }

  .code-block__copy {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    min-height: 2.25rem;
    padding: 0.4rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    background: var(--color-timberwolf-950);
    color: var(--color-timberwolf-200);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    z-index: 1;
    transition:
      background-color 160ms ease-out,
      color 160ms ease-out;
  }

  .code-block__copy:hover {
    background: var(--color-timberwolf-900);
    color: var(--color-timberwolf-50);
  }

  .code-block__copy svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .code-block__check-icon,
  .code-block__copy[data-copied="true"] .code-block__copy-icon {
    display: none;
  }

  .code-block__copy[data-copied="true"] .code-block__check-icon {
    display: block;
  }

  .code-block__copy span {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .code-fold__controls {
    display: flex;
    justify-content: center;
    padding: 0.75rem 1rem 1rem;
  }

  .code-fold[data-expanded="false"] .code-fold__controls {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    padding-top: 4rem;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--code-surface) 62%
    );
    pointer-events: none;
  }

  .code-fold__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.5rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--color-timberwolf-950);
    color: var(--color-timberwolf-100);
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    pointer-events: auto;
    transition:
      background-color 160ms ease-out,
      color 160ms ease-out;
  }

  .code-fold__toggle:hover {
    background: var(--color-timberwolf-900);
    color: var(--color-timberwolf-50);
  }

  .code-fold__toggle svg {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 180ms cubic-bezier(0.25, 1, 0.5, 1);
  }

  .code-fold[data-expanded="true"] .code-fold__toggle svg {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .code-fold__toggle,
    .code-fold__toggle svg,
    .code-block__copy {
      transition: none;
    }
  }
</style>
