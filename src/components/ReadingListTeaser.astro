---
import { BookOpen, Pin } from "@lucide/astro";
import FormattedDate from "@/components/FormattedDate.astro";
import {
  getPublishedReadings,
  getReadings,
  READING_LIST_PATH,
  READING_LIST_TITLE,
  readingDomain,
} from "@/lib/readings";

type Props = {
  /**
   * card    — bordered "living document" block above the posts
   * strip   — rules-enclosed excerpt of the newest entries
   * rail    — single quiet line under the page title
   * section — labelled block below the post list
   * row     — pinned first row of an index-style post list
   */
  variant?: "card" | "strip" | "rail" | "section" | "row";
  /** How many entries the strip variant previews. */
  limit?: number;
};

const { variant = "card", limit = 3 } = Astro.props;

const published = await getPublishedReadings();
// Match the reading-list page: drafts count in dev so the teaser is previewable.
const readings = import.meta.env.DEV ? await getReadings() : published;
const lastUpdated = readings[0]?.data.readDate;
const count = readings.length;
const countLabel = `${count} ${count === 1 ? "reading" : "readings"}`;
const blurb =
  "Not a blog post — a continuously updated list of articles, talks and papers I recommend, each with a short note on why.";
---

{
  count > 0 && lastUpdated && (
    <>
      {variant === "card" && (
        <a
          href={READING_LIST_PATH}
          class="group border-border bg-card/50 focus-visible:outline-ring/70 mb-14 block rounded-2xl border border-dashed p-6 focus-visible:outline-2 focus-visible:outline-offset-4 sm:p-7"
        >
          <p class="eyebrow mb-3 flex items-center gap-2">
            <BookOpen class="size-4" aria-hidden="true" />
            Living document
          </p>
          <h2 class="h3 group-hover:text-secondary transition-colors">
            {READING_LIST_TITLE}
          </h2>
          <p class="text-muted-foreground mt-2 max-w-2xl text-sm leading-relaxed">
            {blurb}
          </p>
          <p class="eyebrow mt-5">
            {`${countLabel} · updated`} <FormattedDate date={lastUpdated} />
          </p>
        </a>
      )}

      {variant === "strip" && (
        <section class="border-border/60 mb-14 border-y py-8">
          <p class="eyebrow mb-2">{`Living document · ${countLabel}`}</p>
          <h2 class="h4 mb-6">
            <a
              href={READING_LIST_PATH}
              class="hover:text-secondary transition-colors"
            >
              {READING_LIST_TITLE} <span aria-hidden="true">→</span>
            </a>
          </h2>
          <ul class="list-none space-y-3 p-0">
            {readings.slice(0, limit).map((reading) => (
              <li>
                <a
                  href={`${READING_LIST_PATH}#${reading.id}`}
                  class="group flex items-baseline gap-4 text-sm"
                >
                  <span class="text-muted-foreground w-24 shrink-0 tabular-nums">
                    <FormattedDate date={reading.data.readDate} />
                  </span>
                  <span class="group-hover:text-secondary min-w-0 flex-1 truncate transition-colors">
                    {reading.data.title}
                  </span>
                  <span class="text-muted-foreground hidden shrink-0 text-xs sm:inline">
                    {reading.data.siteName ?? readingDomain(reading.data.url)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
          {count > limit && (
            <p class="mt-6 text-right">
              <a
                href={READING_LIST_PATH}
                class="eyebrow hover:text-foreground transition-colors"
              >
                See all {count} <span aria-hidden="true">→</span>
              </a>
            </p>
          )}
        </section>
      )}

      {variant === "rail" && (
        <a
          href={READING_LIST_PATH}
          class="group border-border/60 mb-14 flex flex-col gap-1 border-b pb-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6"
        >
          <span class="group-hover:text-secondary min-w-0 transition-colors">
            {READING_LIST_TITLE} <span aria-hidden="true">→</span>
          </span>
          <span class="eyebrow shrink-0">
            {`${countLabel} · `}
            <FormattedDate date={lastUpdated} />
          </span>
        </a>
      )}

      {variant === "row" && (
        <li>
          <a
            href={READING_LIST_PATH}
            class="group flex flex-col gap-1 py-6 sm:flex-row sm:gap-8"
          >
            <span class="eyebrow flex shrink-0 items-center gap-1.5 self-start pt-1 sm:w-28">
              <Pin class="size-3.5" aria-hidden="true" />
              Pinned
            </span>
            <span class="min-w-0 flex-1">
              <span class="h4 group-hover:text-secondary block transition-colors">
                {READING_LIST_TITLE} <span aria-hidden="true">→</span>
              </span>
              <span class="text-muted-foreground mt-1.5 block text-sm leading-relaxed">
                A continuously updated list of articles, talks and papers I
                recommend, each with a short note on why — {countLabel}, updated{" "}
                <FormattedDate date={lastUpdated} />
              </span>
            </span>
          </a>
        </li>
      )}

      {variant === "section" && (
        <section class="border-border/60 mt-20 border-t pt-10">
          <p class="eyebrow mb-4">Also here</p>
          <a href={READING_LIST_PATH} class="group block">
            <h2 class="h3 group-hover:text-secondary transition-colors">
              {READING_LIST_TITLE} <span aria-hidden="true">→</span>
            </h2>
            <p class="text-muted-foreground mt-2 max-w-2xl leading-relaxed">
              {blurb}
            </p>
            <p class="eyebrow mt-5">
              {`${countLabel} · updated`} <FormattedDate date={lastUpdated} />
            </p>
          </a>
        </section>
      )}
    </>
  )
}
